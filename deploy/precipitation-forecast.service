[Unit]
Description=Precipitation Forecast Django API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=forecast
Group=forecast
WorkingDirectory=/srv/precipitation-forecast/backend
EnvironmentFile=/srv/precipitation-forecast/.env
ExecStart=/srv/precipitation-forecast/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
