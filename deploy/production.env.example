# Copy to the repository root as .env and replace every placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=precipitation-forecast.duckdns.org

DB_NAME=precipitation
DB_USER=precipitation
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5433

FORECAST_MODEL=ifs
FORECAST_STREAM=oper
FORECAST_RESOLUTION=0p25
FORECAST_SOURCE_CACHE_TTL_SECONDS=86400
FORECAST_TILE_CACHE_TTL_SECONDS=86400
FORECAST_CACHE_DIR=/var/cache/precipitation-forecast
