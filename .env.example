DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=precipitation
DB_USER=precipitation
DB_PASSWORD=precipitation
DB_HOST=127.0.0.1
DB_PORT=5433

FORECAST_MODEL=ifs
FORECAST_STREAM=oper
FORECAST_RESOLUTION=0p25
FORECAST_SOURCE_CACHE_TTL_SECONDS=86400
FORECAST_TILE_CACHE_TTL_SECONDS=86400
# Keep downloaded source files and generated tiles outside this repository.
FORECAST_CACHE_DIR=/tmp/precipitation-forecast-cache
